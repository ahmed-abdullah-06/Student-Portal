# Production environment template. Copy to `.env` on the server and fill in.
#   cp .env.production.example .env
# Generate secrets with: openssl rand -base64 48

# ---- Core ----
DOMAIN=portal.university.edu
ACME_EMAIL=it@university.edu
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-64-char-random-string

# Tenant resolution: subdomains of this base map to tenants
# (e.g. novastra.portal.university.edu → tenant slug "novastra")
TENANT_BASE_DOMAIN=portal.university.edu

# ---- Payments ----
# simulated = in-built demo flow | stripe = real card payments
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=pkr

# ---- Email (SMTP) ---- absent = dev outbox (not for production)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@university.edu
SMTP_PASS=
SMTP_FROM=Novastra <no-reply@university.edu>

# ---- SMS ---- none | twilio | http
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
# Generic HTTP gateway: URL with {to} and {text} placeholders
SMS_HTTP_URL=

# ---- Monitoring ----
METRICS_TOKEN=change-me-metrics-bearer-token
SENTRY_DSN=
# Frontend Vite build-time telemetry (do not use a secret key here).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=

# ---- Object storage (optional; default = local disk) ----
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# BACKUP_S3_PREFIX=database-backups/
# BACKUP_ALERT_WEBHOOK=https://hooks.slack.com/services/replace-me
# BACKUP_DIR=/var/lib/student-portal/backups
# Optional PDF branding assets (mount the logo path into the backend container).
PDF_UNIVERSITY_NAME="Novastra University"
PDF_UNIVERSITY_ADDRESS="Main Campus · Office of the Registrar · www.novastra.edu.pk"
PDF_LOGO_PATH="/app/assets/university-logo.png"
PDF_REGISTRAR_SIGNATURE="Registrar / Director Student Affairs"
